# Cloudflare D1 Credentials
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_cloudflare_d1_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Daemon & Bot Configuration
DAEMON_PORT=8080
HEADLESS=true

# Security
WEBHOOK_SECRET=your_webhook_secret
ADMIN_PASSKEY=your_admin_passkey

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_OWNER_IDS=your_telegram_owner_ids

# Mailu Mail Engine
MAILU_DOMAIN=mailu.site
MAILU_API_KEY=your_mailu_api_key

# GitHub Token
GITHUB_TOKEN=your_github_token
